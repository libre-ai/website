{
  "name": "@libre-ai/website-gates",
  "private": true,
  "license": "EUPL-1.2",
  "type": "module",
  "packageManager": "bun@1.4.0-canary.1",
  "engines": {
    "bun": ">=1.4.0"
  },
  "overrides": {
    "fast-uri": "4.1.4",
    "lodash": "4.18.1",
    "simple-git": "3.36.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@clevercloud/client": "12.0.0",
    "@libre-ai/contracts-authority": "github:libre-ai/contracts#ee144f03cf7d3deeda02a9fcd5e10377c2e99cb4",
    "@libre-ai/governance": "github:libre-ai/governance#9ac334cdf86cf05d126091f394d07c01d7745930",
    "@libre-ai/ui": "github:libre-ai/ui#99282032a9c71ca4c30efeb441329144ff95cbf8",
    "@playwright/test": "1.61.1",
    "@types/bun": "1.3.14",
    "clever-tools": "4.11.0",
    "typescript": "7.0.2"
  },
  "scripts": {
    "check:bun:runtime": "bun node_modules/@libre-ai/governance/tools/quality/check-bun-minimum.ts",
    "check:bun": "bun run check:bun:runtime && bun node_modules/@libre-ai/governance/tools/quality/check-bun-manifests.ts",
    "check:toolchain": "bun run check:bun && bun node_modules/@libre-ai/governance/tools/quality/check-toolchain.ts",
    "build": "bun run check:bun && bun src/build.ts",
    "sync:deployment-artifact": "bun run check:bun:runtime && bun tools/clever/sync-site.ts",
    "preview:brand": "bun run check:bun:runtime && bun src/preview.ts",
    "clever:personal": "bun run check:bun:runtime && bun tools/clever/personal.ts",
    "clever:doctor": "bun run check:bun:runtime && bun tools/clever/personal.ts doctor",
    "clever:login": "bun run check:bun:runtime && bun tools/clever/personal.ts login",
    "test:e2e": "bun run check:bun:runtime && bun run build && env -u NO_COLOR -u FORCE_COLOR playwright test",
    "test:e2e:brand-local": "bun run check:bun:runtime && LIBRE_AI_WEBSITE_OUTPUT_ROOT=.preview env -u NO_COLOR -u FORCE_COLOR playwright test",
    "check:secret-scan": "bun run check:bun:runtime && bun node_modules/@libre-ai/governance/tools/quality/check-secret-scan.ts",
    "check:personal-data": "bun run check:bun:runtime && bun node_modules/@libre-ai/governance/tools/quality/check-personal-data-boundary.ts",
    "check:licensing": "bun run check:bun:runtime && reuse lint && bun node_modules/@libre-ai/governance/tools/quality/check-declared-licenses.ts",
    "lint": "bun run check:bun:runtime && biome ci .",
    "typecheck": "bun run check:bun:runtime && tsc --noEmit -p tsconfig.json",
    "pretest": "bun run check:bun",
    "test": "bun test",
    "check": "bun run check:bun && bun run check:toolchain && bun run build && bun run check:secret-scan && bun run check:personal-data && bun run check:licensing && bun run lint && bun run typecheck && bun run test"
  }
}
